{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "atr": {
      "type": "stdio",
      "command": "atr",
      "args": ["mcp"]
    },
    "atr-remote": {
      "type": "streamable-http",
      "url": "https://${ATR_MCP_HOST}/mcp",
      "headers": {
        "Authorization": "Bearer ${ATR_MCP_TOKEN}"
      }
    }
  }
}
